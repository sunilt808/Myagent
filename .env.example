# myagent — environment template. Copy to .env and fill in your keys.
# myagent reads keys from: shell -> current folder .env -> myagent folder .env -> ~/.myagent/.env

OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
HF_TOKEN=

# Optional (slots exist, add a key to activate)
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=