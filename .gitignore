# myagent — .gitignore
# Last updated: 2026-09-05 (docs removed from repo — README is the single source)

# Dependencies
node_modules/

# Secrets & config — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem

# User-local runtime data (config.json, sessions/, providers/<id>.json cache)
.myagent/
last-balance-alert.json

# Docs & test artifacts — kept local only
docs/
result.txt
tools/*.json
model-test-*.json
docs/*.journal.md

# OS / editor noise
.DS_Store
Thumbs.db
*.log