# myagent — .gitignore
# Last updated: 2026-09-05 (provider-isolation build v1.1)

# Dependencies
node_modules/

# Secrets & config — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem

# User-local runtime data (config.json, sessions/, providers/<id>.json cache)
.myagent/
last-balance-alert.json

# Test artifacts
tools/*.json
model-test-*.json
docs/*.journal.md

# OS / editor noise
.DS_Store
Thumbs.db
*.log